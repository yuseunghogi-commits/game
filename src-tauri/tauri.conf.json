{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLANETARY GRID",
  "version": "0.1.0",
  "identifier": "com.planetarygrid.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PLANETARY GRID",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "StrategyGame",
    "shortDescription": "행성 규모 에너지 기업 경영 시뮬레이션",
    "longDescription": "작은 전력회사에서 시작해 행성 전체의 에너지 흐름을 설계하고 운영하는 경영 시뮬레이션"
  }
}
