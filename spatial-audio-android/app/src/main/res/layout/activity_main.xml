<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3D 사운드"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="유튜브·넷플릭스·음악앱 소리를 헤드폰용 입체 음향으로"
            android:textColor="#FFAAAAC0"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1E1E2A"
            android:padding="16dp"
            android:text="3D 음향 켜기"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionTitle"
            android:text="처리 방식" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="강력 3D 모드 (추천) — 앱이 직접 3D 계산, 블루투스에서도 확실함"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:text="기본 모드 — 폰 내장 효과 사용 (약할 수 있음)"
                android:textColor="#FFDDDDEE"
                android:textSize="15sp" />
        </RadioGroup>

        <Button
            android:id="@+id/buttonDump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 강력 모드 권한 받기 (처음 1번, 앱 안에서 바로)" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF1A1A24"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="#FFCCCCDD"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="프리셋" />

        <Spinner
            android:id="@+id/spinnerPreset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FF1E1E2A" />

        <TextView
            android:id="@+id/labelVirtualizer"
            style="@style/SliderLabel" />

        <SeekBar
            android:id="@+id/seekVirtualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000" />

        <LinearLayout
            android:id="@+id/layoutGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="🎧 헤드폰 보정" />

            <Spinner
                android:id="@+id/spinnerHpEq"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FF1E1E2A" />

            <TextView
                android:id="@+id/textHpEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFAAAAC0"
                android:textSize="12sp" />

            <TextView
                style="@style/SectionTitle"
                android:text="3D 엔진" />

            <Spinner
                android:id="@+id/spinnerEngine"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FF1E1E2A" />

            <TextView
                android:id="@+id/textEngineInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFAAAAC0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/labelSpread"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekSpread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90" />

            <TextView
                style="@style/SliderLabel"
                android:text="👂 귀 맞춤 (실측 엔진) — 앞/뒤가 헷갈리면 테스트로 내 귀에 맞는 단계를 고르세요" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerEar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#FF1E1E2A" />

                <Button
                    android:id="@+id/buttonEarTest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="귀 맞춤 테스트" />
            </LinearLayout>

            <TextView
                android:id="@+id/labelEnhance"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekEnhance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                style="@style/SliderLabel"
                android:text="🔊 스피커 배치 — 끌어서 옮기세요 (🟣 앞 / 🔵 뒤 / ▲ 천장 / ▼ 바닥). 안쪽일수록 높고, 실선 원 바깥은 아래" />

            <com.spatialsound.app.SpeakerLayoutView
                android:id="@+id/speakerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FF1A1A24" />

            <TextView
                android:id="@+id/labelFront"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekFront"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90" />

            <TextView
                android:id="@+id/labelRearAngle"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekRearAngle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90" />

            <TextView
                android:id="@+id/labelRearLevel"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekRearLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/labelCenter"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/labelElev"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekElev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60" />

            <TextView
                android:id="@+id/labelHeight"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/labelBottom"
                style="@style/SliderLabel" />

            <SeekBar
                android:id="@+id/seekBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/textHeightMore"
                style="@style/SliderLabel"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="#FF9E8CFF"
                android:text="📐 천장·바닥 스피커 위치 세부 조절 ▸" />

            <LinearLayout
                android:id="@+id/heightMoreGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/labelTopAngle"
                    style="@style/SliderLabel" />

                <SeekBar
                    android:id="@+id/seekTopAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="90" />

                <TextView
                    android:id="@+id/labelTopElev"
                    style="@style/SliderLabel" />

                <SeekBar
                    android:id="@+id/seekTopElev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="55" />

                <TextView
                    android:id="@+id/labelTopRearAngle"
                    style="@style/SliderLabel" />

                <SeekBar
                    android:id="@+id/seekTopRearAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="90" />

                <TextView
                    android:id="@+id/labelTopRearElev"
                    style="@style/SliderLabel" />

                <SeekBar
                    android:id="@+id/seekTopRearElev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="55" />

                <TextView
                    android:id="@+id/labelBottomAngle"
                    style="@style/SliderLabel" />

                <SeekBar
                    android:id="@+id/seekBottomAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="180" />

                <TextView
                    android:id="@+id/labelBottomElev"
                    style="@style/SliderLabel" />

                <SeekBar
                    android:id="@+id/seekBottomElev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/labelWidth"
            style="@style/SliderLabel" />

        <SeekBar
            android:id="@+id/seekWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <LinearLayout
            android:id="@+id/headGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FF1E1E2A"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                style="@style/SliderLabel"
                android:layout_marginTop="0dp"
                android:text="🧭 헤드 트래킹 — 고개를 돌려도 소리가 제자리에 (이어폰 센서 사용)" />

            <Spinner
                android:id="@+id/spinnerHeadSource"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#FF2A2A38" />

            <TextView
                android:id="@+id/textHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFAAAAC0"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonRecenter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="정면 다시 맞추기" />

                <Switch
                    android:id="@+id/switchHeadInvert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="방향 반대로"
                    android:textColor="#FFDDDDEE" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchHeadPitch"
                style="@style/OptionSwitch"
                android:text="위아래 고개 움직임도 따라가기 (갤럭시 버즈)" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelSpace"
            style="@style/SliderLabel" />

        <SeekBar
            android:id="@+id/seekSpace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/labelBass"
            style="@style/SliderLabel" />

        <SeekBar
            android:id="@+id/seekBass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000" />

        <TextView
            android:id="@+id/labelReverb"
            style="@style/SliderLabel" />

        <Spinner
            android:id="@+id/spinnerReverb"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FF1E1E2A" />

        <TextView
            style="@style/SectionTitle"
            android:text="옵션" />

        <Switch
            android:id="@+id/switchGlobal"
            style="@style/OptionSwitch"
            android:text="모든 앱에 적용 (유튜브 등 포함)" />

        <Switch
            android:id="@+id/switchHeadphonesOnly"
            style="@style/OptionSwitch"
            android:text="헤드폰/이어폰 연결 시에만 적용" />

        <Button
            android:id="@+id/buttonTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🎧 3D 테스트 사운드 (머리 주위를 도는 소리)" />

        <Button
            android:id="@+id/buttonSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="기기 내장 공간 음향 설정 열기" />

        <TextView
            style="@style/SectionTitle"
            android:text="앱 업데이트" />

        <Button
            android:id="@+id/buttonUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 업데이트 확인" />

        <Switch
            android:id="@+id/switchAutoUpdate"
            style="@style/OptionSwitch"
            android:text="새 버전 자동 확인 (앱을 열 때, 설정·권한은 유지)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="팁: 효과가 안 느껴지면 다른 이퀄라이저 앱(삼성 Dolby Atmos, Wavelet 등)을 끄고 다시 켜 보세요. 빠른 설정 패널에 '3D 사운드' 타일을 추가하면 한 번에 켜고 끌 수 있습니다."
            android:textColor="#FF8888A0"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
