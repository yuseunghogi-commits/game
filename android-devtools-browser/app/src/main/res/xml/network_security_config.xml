<?xml version="1.0" encoding="utf-8"?>
<!-- 개발용: http(로컬 개발 서버)와 사용자가 설치한 인증서(mkcert, 프록시 디버거 등)를 허용한다. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
